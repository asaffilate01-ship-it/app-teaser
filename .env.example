# Safe to expose in the browser. Never put secret/service-role keys in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_STRIPE_PRICE_CLUB=price_REPLACE_ME
VITE_MONITORING_ENDPOINT=
VITE_RELEASE_SHA=development

# Server and Supabase Edge Function secrets. Store them in their target runtimes; never expose them.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
PUBLIC_APP_ORIGINS=https://app-teaser.lovable.app,https://criclume.com,https://www.criclume.com
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PRICE_CLUB=price_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
RAIN_RULE_PROVIDER_URL=
RAIN_RULE_PROVIDER_KEY=
AI_ANALYSIS_ENDPOINT=
AI_ANALYSIS_API_KEY=
VIDEO_TRANSCODE_ENDPOINT=
VIDEO_TRANSCODE_API_KEY=
VIDEO_CALLBACK_SECRET=
EMAIL_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_API_KEY=
CRON_SECRET=

# Backend-only CricLume -> Omniqora Intelligence (use Lovable Supabase secrets).
# Never prefix a platform credential with VITE_.
OMNIQORA_CRICLUME_ENABLED=false
# Paid calls remain prohibited until a certified worker, approved tariff and cost reconciliation.
OMNIQORA_CRICLUME_PAID_ENABLED=false
OMNIQORA_INTELLIGENCE_URL=https://YOUR_OMNIQORA_HOST/api/platform/intelligence
OMNIQORA_SERVICE_AUTH=YOUR_PLATFORM_KEY_ID.YOUR_SERVER_ONLY_SECRET

# User-delegated, read-only MCP evidence; no raw media export.
CRICLUME_MCP_ENABLED=false
